diff --git a/scripting/javascript/bindings/XMLHTTPRequest.cpp b/scripting/javascript/bindings/XMLHTTPRequest.cpp
index 2a867d4..93276c1 100644
--- a/scripting/javascript/bindings/XMLHTTPRequest.cpp
+++ b/scripting/javascript/bindings/XMLHTTPRequest.cpp
@@ -178,10 +178,55 @@ void MinXmlHttpRequest::handle_requestResponse(cocos2d::extension::CCHttpClient
     char statusString[64] = {};
     sprintf(statusString, "HTTP Status Code: %d, tag = %s", statusCode, response->getHttpRequest()->getTag());
     
-    if (!response->isSucceed())
+    const bool requestSucceeded = response->isSucceed() && statusCode == 200;
+    if (!requestSucceeded)
     {
-        CCLOG("response failed");
-        CCLOG("error buffer: %s", response->getErrorBuffer());
+        const char* requestUrl = response->getHttpRequest()->getUrl();
+        const std::string safeUrl = requestUrl ? std::string(requestUrl).substr(0, std::string(requestUrl).find('?')) : "";
+        const char* errorBuffer = response->getErrorBuffer();
+        std::vector<char> *responseBuffer = response->getResponseData();
+        std::string responseBody(responseBuffer->begin(), responseBuffer->end());
+        std::string errorText;
+
+        // Prefer the transport error, but preserve an HTTP error body (often
+        // the server's JSON message) when libcurl itself reports no detail.
+        if (errorBuffer && errorBuffer[0] != '\0') {
+            errorText = errorBuffer;
+        } else if (!responseBody.empty()) {
+            errorText = responseBody;
+        } else if (statusCode > 0) {
+            char httpError[64] = {};
+            sprintf(httpError, "HTTP %d", statusCode);
+            errorText = httpError;
+        } else {
+            errorText = "network request failed";
+        }
+
+        CCLOG("XHR failed: url=%s status=%d tag=%s", safeUrl.c_str(), statusCode,
+              response->getHttpRequest()->getTag());
+        CCLOG("XHR error: %s", errorText.c_str());
+        if (!responseBody.empty() && responseBody != errorText) {
+            CCLOG("XHR response: %s", responseBody.c_str());
+        }
+
+        // The old implementation returned here, leaving the JS state machine
+        // in its waiting step forever. Expose a terminal failed response so
+        // JS can log it and show the normal NetConnectErr dialog.
+        status = response->isSucceed() && statusCode > 0 ? statusCode : 0;
+        statusText = errorText;
+        readyState = DONE;
+        data.str("");
+        data.clear();
+        data << errorText;
+        dataSize = data.str().size();
+
+        js_proxy_t *p = jsb_get_native_proxy((void*)this);
+        if (p && onreadystateCallback) {
+            JSContext* callbackContext = ScriptingCore::getInstance()->getGlobalContext();
+            jsval callbackValue = OBJECT_TO_JSVAL(onreadystateCallback);
+            jsval callbackResult;
+            JS_CallFunctionValue(callbackContext, NULL, callbackValue, 0, NULL, &callbackResult);
+        }
         return;
     }
     
